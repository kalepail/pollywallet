{
  "include": ["**/*.ts", "**/*.tsx"],
  // bindings/ is a workspace package with its own tsconfig + build; e2e-policy-test
  // and dist are not app sources. Without this the root typecheck reports errors for
  // generated bindings code under settings that package never opted into.
  "exclude": ["node_modules", "dist", "bindings", "e2e-policy-test"],
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "paths": {
      "@/*": ["./src/*"]
    },
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [
        "./worker-configuration.d.ts",
        "node",
        "vite/client"
    ],

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    /* Linting */
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  }
}
